    <!-- Bienvenue -->
    <string name="welcome1_title">Bienvenue dans Make My Day</string>
    <string name="welcome1_intro">Découvrez des lieux intéressants et insolites à visiter à Londres, ainsi que les événements qui s’y déroulent.</string>
    <string name="welcome1_tip1">La carte affiche les lieux à proximité. Les épingles colorées signalent des événements le jour consulté ; les épingles grises n’en ont pas.</string>
    <string name="welcome1_tip2">Choisissez une date en haut de la liste pour voir les événements à venir.</string>
    <string name="welcome1_tip3">Enregistrez des événements, planifiez votre journée et recevez un rappel avant leur fin.</string>
    <string name="welcome2_title">Découvrez les événements</string>
    <string name="welcome2_intro">Explorez les alentours, où que vous soyez ou où que vous alliez.</string>
    <string name="welcome2_tip1">« À proximité » affiche les lieux et les événements autour de vous.</string>
    <string name="welcome2_tip2">Appuyez n’importe où sur la carte pour voir ce qui se trouve autour.</string>
    <string name="welcome2_tip3">Recherchez un lieu ou une station, ou recherchez des événements par mot-clé.</string>
    <string name="welcome3_title">Planifiez votre journée</string>
    <string name="welcome3_intro">Ouvrez un événement pour en profiter pleinement.</string>
    <string name="welcome3_tip1">Enregistrez-le ou ajoutez-le à Ma journée. Connectez-vous avec Google, une clé d’accès ou votre adresse e-mail.</string>
    <string name="welcome3_tip2">Ajoutez-le à votre agenda ou partagez-le avec vos amis.</string>
    <string name="welcome3_tip3">Obtenez un itinéraire à pied jusqu’au lieu. Idéal lorsque vous êtes à proximité.</string>
    <string name="action_start_exploring">Commencer l’exploration</string>

