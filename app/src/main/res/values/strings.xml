    <!-- Welcome -->
    <string name="welcome1_title">Welcome to Make My Day</string>
    <string name="welcome1_intro">Find interesting and unusual places to visit in London, and what\'s on there.</string>
    <string name="welcome1_tip1">The map shows venues nearby. Coloured pins have events on the day you\'re looking at; grey pins don\'t.</string>
    <string name="welcome1_tip2">Pick a date at the top of the list to see what\'s on in the future.</string>
    <string name="welcome1_tip3">Save events, plan your day and get a reminder before they end.</string>
    <string name="welcome2_title">Find what\'s on</string>
    <string name="welcome2_intro">Look around wherever you are, or wherever you\'re going.</string>
    <string name="welcome2_tip1">Near me shows venues and events around you.</string>
    <string name="welcome2_tip2">Tap anywhere on the map to see what\'s around that spot.</string>
    <string name="welcome2_tip3">Search for a venue or station, or search events by keyword.</string>
    <string name="welcome3_title">Plan your day</string>
    <string name="welcome3_intro">Open an event to make the most of it.</string>
    <string name="welcome3_tip1">Save it or add it to My Day. Log in with Google, a passkey or your email.</string>
    <string name="welcome3_tip2">Add it to your calendar, or share it with friends.</string>
    <string name="welcome3_tip3">Get walking directions to the venue. Best when you\'re nearby.</string>
